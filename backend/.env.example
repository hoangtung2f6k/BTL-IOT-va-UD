# Mẫu cấu hình. Chép thành .env rồi sửa cho khớp máy của bạn:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Git Bash / Linux / macOS)

# ===== Cơ sở dữ liệu MySQL =====
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_db
DB_PORT=3306

# ===== MQTT =====
# Broker công cộng, không cần cài gì thêm:
MQTT_BROKER=mqtt://broker.emqx.io:1883
# Hoặc broker nội bộ (phải chạy mosquitto, ESP trỏ về IP LAN của máy này):
# MQTT_BROKER=mqtt://admin:123456@192.168.1.10:1884

MQTT_TOPIC_SENSOR=iot/room/1/sensor/data
MQTT_TOPIC_DEVICE_CONTROL=iot/room/1/device/control
MQTT_TOPIC_DEVICE_RESPONSE=iot/room/1/device/response
MQTT_TOPIC_DEMO_CHAT=iot/demo/terminal-chat

# ===== Máy chủ =====
PORT=3000

# Khóa ký JWT. Để trống thì code dùng giá trị mặc định trong server.js.
# JWT_SECRET=doi_thanh_chuoi_bi_mat_cua_rieng_ban
